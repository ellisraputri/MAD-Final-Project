{
  "$schema": "https://schema.railpack.com",

  "providers": ["node", "python"],

  "packages": {
    "apt": ["ffmpeg", "libgl1"]
  },

  "steps": {
    "install": {
      "commands": [
        "npm install",
        "pip install -r requirements.txt"
      ]
    }
  },

  "deploy": {
    "startCommand": "npm start"
  }
}