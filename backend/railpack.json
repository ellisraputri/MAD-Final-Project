{
  "$schema": "https://schema.railpack.com",

  "packages": {
    "node": "22",
    "python": "3.13"
  },

  "steps": {
    "install": {
      "commands": [
        "pwd",
        "echo 'HELLO FROM RAILPACK'",
        "ls -la",
        "npm install",
        "pip install -r requirements.txt"
      ]
    }
  },

  "deploy": {
    "startCommand": "npm start"
  }
}