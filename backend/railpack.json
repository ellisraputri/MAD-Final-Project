{
  "$schema": "https://schema.railpack.com",

  "packages": {
    "node": "22",
    "python": "3.13"
  },

  "steps": {
    "install": {
      "commands": [
        "ls -la",
        "ls -la backend",
        "npm install --prefix backend",
        "pip install -r backend/requirements.txt"
      ]
    }
  },

  "deploy": {
    "startCommand": "npm start --prefix backend"
  }
}