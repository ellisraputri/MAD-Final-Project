{
  "$schema": "https://schema.railpack.com",

  "packages": {
    "node": "22",
    "python": "3.13"
  },

  "steps": {
    "install": {
      "commands": [
        "find / -name 'package.json' -not -path '*/node_modules/*' 2>/dev/null || true",
        "ls -la /app || true",
        "npm install",
        "pip install -r requirements.txt"
      ]
    }
  },

  "deploy": {
    "startCommand": "npm start"
  }
}