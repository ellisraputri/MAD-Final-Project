{
  "$schema": "https://schema.railpack.com",

  "providers": ["node", "python"],

  "steps": {
    "install": {
      "commands": [
        "cd backend && npm install",
        "cd backend && pip install -r requirements.txt"
      ]
    }
  },

  "deploy": {
    "startCommand": "cd backend && npm start"
  }
}